<?php $pageTitle = 'Productos'; ?>
<?php require __DIR__ . '/../componentes/header.phtml'; ?>

<section class="page-hero">
  <h1>Todos los Productos</h1>
  <p>Explorá nuestra selección completa</p>
</section>

<!-- Filtro por categoría -->
<div class="filter-bar">
  <a href="<?= BASE_URL ?>/productos" class="filter-chip <?= !isset($_GET['cat']) ? 'active' : '' ?>">
    Todo
  </a>
  <?php foreach ($categorias as $cat): ?>
    <a href="<?= BASE_URL ?>/categorias/productos?id=<?= $cat['id_categoria'] ?>" class="filter-chip">
      <?= htmlspecialchars($cat['nombre']) ?>
    </a>
  <?php endforeach; ?>
</div>

<?php if (empty($productos)): ?>
  <div class="empty-state">
    <p>No hay productos cargados todavía.</p>
  </div>
<?php else: ?>
  <div class="products-grid">
    <?php foreach ($productos as $p): ?>
      <article class="product-card">
        <a href="<?= BASE_URL ?>/productos/detalle?id=<?= $p['id_producto'] ?>" class="card-link">
          <div class="card-image">
            <?php if (!empty($p['imagen_url'])): ?>
              <img src="<?= htmlspecialchars($p['imagen_url']) ?>" alt="<?= htmlspecialchars($p['nombre']) ?>">
            <?php else: ?>
              <div class="card-placeholder">🛍️</div>
            <?php endif; ?>
          </div>
          <div class="card-body">
            <span class="card-category"><?= htmlspecialchars($p['categoria_nombre'] ?? 'Sin categoría') ?></span>
            <h3 class="card-title"><?= htmlspecialchars($p['nombre']) ?></h3>
            <p class="card-desc"><?= htmlspecialchars(mb_strimwidth($p['descripcion'] ?? '', 0, 80, '…')) ?></p>
            <div class="card-footer">
              <span class="price">$<?= number_format((float) $p['precio'], 2, ',', '.') ?></span>
              <span class="stock <?= $p['stock'] > 0 ? 'in-stock' : 'no-stock' ?>">
                <?= $p['stock'] > 0 ? 'En stock' : 'Sin stock' ?>
              </span>
            </div>
          </div>
        </a>
      </article>
    <?php endforeach; ?>
  </div>
<?php endif; ?>

<?php require __DIR__ . '/../componentes/footer.phtml'; ?>