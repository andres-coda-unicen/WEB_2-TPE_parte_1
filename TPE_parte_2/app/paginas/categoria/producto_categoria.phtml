    encontrado
    <?= count($productos) !== 1 ? 's' : '' ?>
  </p>
  <div class="products-grid">
    <?php foreach ($productos as $p): ?>
      <article class="product-card">
        <a href="<?= BASE_URL ?>/producto/detalle?id=<?= $p['id_producto'] ?>" class="card-link">
          <div class="card-image">
            <?php if (!empty($p['imagen_url'])): ?>
              <img src="<?= htmlspecialchars($p['imagen_url']) ?>" alt="<?= htmlspecialchars($p['nombre']) ?>">
            <?php else: ?>
              <div class="card-placeholder">🛍️</div>
            <?php endif; ?>
          </div>
          <div class="card-body">
            <span class="card-category">
              <?= htmlspecialchars($p['categoria_nombre'] ?? 'Sin categoría') ?>
            </span>
